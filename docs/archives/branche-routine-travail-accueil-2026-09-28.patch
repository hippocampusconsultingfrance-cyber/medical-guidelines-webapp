+
+function Chip({ x, y, label, fill }: { x: number; y: number; label: string; fill: string }) {
+  return (
+    <g>
+      <rect x={x} y={y} width="34" height="16" rx="8" fill={fill} />
+      <text x={x + 17} y={y + 11.5} textAnchor="middle" fontSize="9" fontWeight="600" fill="#fff" fontFamily="sans-serif">
+        {label}
+      </text>
+    </g>
+  );
+}
+
+function FicheCard({ x, y, w }: { x: number; y: number; w: number }) {
+  return (
